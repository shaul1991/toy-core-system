APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# local: http://localhost:8000
# dev: https://dev.shaul.link
# production: https://www.shaul.link
APP_URL=http://localhost:8000

# Frontend URL (BFF 콜백에서 사용)
# local: http://localhost:3000
# dev: https://dev.shaul.link
# production: https://www.shaul.link
FRONTEND_URL=http://localhost:3000

# Swagger UI (set to true to enable)
SWAGGER_UI_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# 쿠키 도메인 설정 (프로덕션 환경에서 명시적 설정 권장)
# 서브도메인 간 쿠키 공유: .example.com (앞에 점 필수)
# 로컬 개발: null
SESSION_DOMAIN=null

# HTTPS 환경에서 true로 설정 (프로덕션 필수)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO Configuration (Multi-Bucket)
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_URL=http://localhost:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true
MINIO_PUBLIC_BUCKET=public
MINIO_PRIVATE_BUCKET=private

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=yes
SENTRY_TRACES_SAMPLE_RATE=

# JWT Configuration
JWT_SECRET=

# Social Login - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=${APP_URL}/api/auth/github/callback

# Social Login - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=${APP_URL}/api/auth/naver/callback

# Social Login - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=${APP_URL}/api/auth/kakao/callback

# MongoDB Configuration
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=toy_core
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
